{
    "name": "tanvir-hasan11/orin-core",
    "description": "Orin Core - a resilient multi-provider AI engine for PHP",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Orin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orin\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/orin"
    ],
    "config": {
        "sort-packages": true
    }
}
