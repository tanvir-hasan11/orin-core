{
    "name": "tanvir-hasan11/orin-core",
    "description": "Orin Core - resilient multi-provider AI engine + full web platform (public site, merchant panel, super admin)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Orin\\": ["src/", "app/"]
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Orin\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/orin",
        "bin/migrate"
    ],
    "config": {
        "sort-packages": true
    }
}
