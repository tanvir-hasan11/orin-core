# ============================================================
# ORIN Core — environment template
# Copy to .env and fill in real values. NEVER commit the real .env.
# ============================================================

APP_MODE=PRODUCTION
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# 64 hex chars. Generate: php -r "echo bin2hex(random_bytes(32));"
# WARNING: changing this invalidates every encrypted token in the DB.
APP_KEY=

# ---- database (cPanel MySQL) ----
DB_HOST=localhost
DB_NAME=orin
DB_USER=orin_user
DB_PASS=

# Must match APP_URL scheme exactly (https, not http)
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Internal token for worker.php HTTP fallback
WORKER_TOKEN=

# ---- AI providers ----
# Primary first, then the failover chain.
# The engine SKIPS any provider whose API key is empty.
LLM_PROVIDER=openrouter
FALLBACK_LLM_PROVIDER=gemini,openai

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# ---- WhatsApp Cloud API ----
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_BUSINESS_ACCOUNT_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_API_VERSION=v21.0

# ---- Messenger / Instagram ----
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ACCESS_TOKEN=
MS_VERIFY_TOKEN=
FB_API_VERSION=v21.0

# ---- Logistics ----
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=

# ---- bKash (optional) ----
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_SANDBOX=true

# ---- Security ----
PAYMENT_WEBHOOK_SECRET=
CRON_SECRET=

# ---- Observability (optional) ----
SENTRY_DSN=
