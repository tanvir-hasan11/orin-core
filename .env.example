# Orin full system configuration
# Copy to .env and fill in real values.

APP_NAME=Orin
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_SESSION_NAME=orin_session
APP_SESSION_LIFETIME=7200
APP_SIGNUP_OPEN=true
APP_DEFAULT_PLAN=free

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=orin
DB_USERNAME=root
DB_PASSWORD=

MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@orin.local

# AI engine
ORIN_AI_PROVIDERS=openai,gemini,openrouter

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

ORIN_MAX_RETRIES=2
ORIN_TIMEOUT=30
ORIN_LOG_PATH=

ORIN_PRICE_MAX_INPUT_TOKENS=8000
ORIN_PRICE_MAX_OUTPUT_TOKENS=2000
ORIN_PRICE_MAX_COST_USD=0.50
